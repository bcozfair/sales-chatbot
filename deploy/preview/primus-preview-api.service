# ─────────────────────────────────────────────────────────────────────────────
#  พรีวิวร่วม — backend (โค้ดของ main · tsx watch · PREVIEW_MODE=1) ที่ 127.0.0.1:3098
#  คู่มือ + วิธีติดตั้ง: docs/dev-preview.md
#
#  เป็น systemd **user** service (ไม่ต้อง sudo) — ขึ้นเองหลังรีบูตได้เพราะ app_sales เปิด linger ไว้
#  ดูสถานะ:  systemctl --user status primus-preview-api
#  ดู log:   journalctl --user -u primus-preview-api -f
#
#  ⚠️ ExecStart ชี้ node ของ nvm ตรง ๆ (systemd ไม่โหลด nvm) — เปลี่ยนเวอร์ชัน node เมื่อไหร่ต้องแก้ path
#  ⚠️ ใช้ฐานตัวจริง — PG_HOST/PG_PORT มาจาก .env ของทรีหลัก (localhost:5432 ที่ override publish ไว้)
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=พรีวิวร่วม chatbot — backend (main · tsx watch) :3098
Documentation=file:///home/app_sales/salechatbot/chatbot/docs/dev-preview.md
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/home/app_sales/salechatbot/chatbot
ExecStart=/home/app_sales/.nvm/versions/node/v22.23.2/bin/node node_modules/.bin/tsx watch --clear-screen=false index.ts
Environment=PATH=/home/app_sales/.nvm/versions/node/v22.23.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=PREVIEW_MODE=1
Environment=PORT=3098
Environment=TZ=Asia/Bangkok
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
